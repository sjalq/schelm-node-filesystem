{
  "name": "schelm-node-filesystem",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "24.4.1"
  },
  "scripts": {
    "assemble": "node scripts/assemble-kernels.cjs",
    "check:assembly": "node scripts/assemble-kernels.cjs --check",
    "test:node": "node --test tests/node/*.test.cjs",
    "test:artifact": "node tests/artifact-gate.cjs",
    "test": "npm run check:assembly && npm run test:toolchain && npm run test:node && npm run test:artifact && npm run test:archive && npm run test:perf && npm run test:elm-workers",
    "perf": "node tests/perf/atomic-replace-bench.cjs",
    "test:toolchain": "node tests/toolchain-gate.cjs",
    "test:archive": "node tests/archive-repro.cjs",
    "test:perf": "node tests/perf/atomic-replace-bench.cjs --gate",
    "test:elm-workers": "node scripts/build-fixtures.cjs"
  }
}
